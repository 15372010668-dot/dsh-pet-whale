{
  "name": "dsh-pet-whale",
  "version": "1.2.0",
  "license": "Apache-2.0",
  "description": "Independent pixel blue-whale desktop pet plugin for DeepSeek Harness. Descended from @michengai/dsh-codex-pet via dsh-bluewhale-pet; dead code removed, own data dir and routes.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/15372010668-dot/dsh-pet-whale.git"
  },
  "homepage": "https://github.com/15372010668-dot/dsh-pet-whale#readme",
  "bugs": {
    "url": "https://github.com/15372010668-dot/dsh-pet-whale/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "lib",
    "assets/branding/dsh-pet-whale-banner.png",
    "assets/codex/bluewhale/spritesheet.webp",
    "assets/screenshots/*.png",
    "skills",
    "docs",
    "overlay",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md",
    "test-host.mjs",
    "FORK.md",
    "test-roam.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check overlay/main.js && node --check overlay/preload.js",
    "test": "node test-host.mjs && node test-roam.mjs && node test-notifications.mjs",
    "sync": "./sync.sh"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.8 || 0.1.1-rc.2 || 0.1.2-rc.1 || 0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.6-alpha.1 || 0.1.6-alpha.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.6-alpha.2",
    "@electron/asar": "^3.4.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
